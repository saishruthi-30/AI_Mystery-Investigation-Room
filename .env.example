# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ai-mystery-room

# Gemini (text generation runs only on the server)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Authentication
SESSION_SECRET=replace-with-a-long-random-secret

# Optional visual generation and storage providers
IMAGE_PROVIDER=
IMAGE_API_KEY=
VIDEO_PROVIDER=
VIDEO_API_KEY=
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
